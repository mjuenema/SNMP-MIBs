	azaleaDot11BssTable	OBJECT-TYPE
		SYNTAX		SEQUENCE  OF  AzaleaDot11BssEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"This table contains attributes to configure radio
        BSS radio interfaces managed by this agent. The attributes
        are extensions to the configuration parameters in
        the dot11ConfigTable defined in the
        IEEE802dot11-MIB. This table configures the role of
        the interface, propriety extensions, hierarchy,
        security option and parameters, and
        communication settings. This table has a sparse
        dependent relationship on the ifTable.
        For each entry in this table, there exists an entry
        in the ifTable of ifType ieee80211(71).
        Entries in this table cannot be created or deleted
        by the network management system. All entries are
        created or deleted by the agent."
		REFERENCE
		"IEEE Std 802.11-Jan 14 1999, Wireless LAN Medium
        Access Control and Physical Layer Specifications,
        LAN MAN Standards Committee of the IEEE Computer
        Society, IEEE802dot11-MIB."
		::=  { azaleaDot11BssObjects  1 }

	azaleaDot11BssEntry	OBJECT-TYPE
		SYNTAX		AzaleaDot11BssEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"A collection of configuration attributes for
        a hostapd BSS radio interface. These attributes
        are supplements to attributes defined in the
        dot11StationConfigTable in IEEE802dot11-MIB."
		REFERENCE		"IEEE Std 802.11-Jan 14 1999, Wireless LAN Medium
        Access Control and Physical Layer Specifications,
        LAN MAN Standards Committee of the IEEE Computer
        Society, IEEE802dot11-MIB."
		INDEX		{  ifIndex, azlDot11BssIndex  }
		::=  { azaleaDot11BssTable 1 }

	AzaleaDot11BssEntry  ::=  SEQUENCE {
		azlDot11BssIndex  INTEGER,
		azlDot11BssName  OCTET STRING,
		azlDot11BssMacAddressAuthenticationType  INTEGER,
		azlDot11BssAuthenticationAlgorithm  INTEGER,
		azlDot11BssWepDefaultKey  Integer32,
