        "The number of times that the system has rebooted."
    ::= { azaleaSysMgmt 1 } 

sysRebootReason OBJECT-TYPE
    SYNTAX      INTEGER {
        unknown (1),
        crash   (2),
        powerOff(3),
        normal  (4),
        lostGateway(5)
    }
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION 
        "This node specifies the reason of last reboot.
        unknown (1): Can not tell what causes reboot
        crash   (2): Software crash
        powerOff(3): Power off then reboot
        normal  (4): Normal reboot"
    ::= { azaleaSysMgmt 2 } 

