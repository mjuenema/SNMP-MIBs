azaleaNtpMgmt    OBJECT IDENTIFIER ::= { azaleaMgmt 16 }

	azaleaNtpPeersTable OBJECT-TYPE
		SYNTAX		SEQUENCE  OF  AzaleaNtpPeersEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"This table contains the NTP peer List."
		::=  { azaleaNtpMgmt  2 }

	azaleaNtpPeersEntry	OBJECT-TYPE
		SYNTAX		AzaleaNtpPeersEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"The entry of the NTP peer table"
		INDEX		{azaleaNtpPeersID }
		::=  { azaleaNtpPeersTable 1 }

	AzaleaNtpPeersEntry  ::=  SEQUENCE {
		azaleaNtpPeersID    INTEGER, 
		azaleaNtpPeersConfigured  TruthValue,
		azaleaNtpPeersAddress   IpAddress 
		}

	azaleaNtpPeersID	OBJECT-TYPE	
		SYNTAX			INTEGER  
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"An integer ID that uniquely 
		identifies a peer with which the local NTP server is associated."
		::=  {  azaleaNtpPeersEntry  1  } 
		 
	azaleaNtpPeersConfigured	OBJECT-TYPE	
		SYNTAX			TruthValue 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"This value indicate that if the association
				was created from configuration information and should not
				be demobilized if the peer becomes unreachable."
		::=  {  azaleaNtpPeersEntry  2  }
	
	azaleaNtpPeersAddress	OBJECT-TYPE	
		SYNTAX			IpAddress
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"The IP address of the NTP server."
		::=  {  azaleaNtpPeersEntry  3  }
         
	azaleaNtpSynchronizedTimeSecs OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS	read-only
		STATUS		current
		DESCRIPTION	"Current NTP synchronized network time in seconds since 1/1/1970 12:00am GMT"
		::=  { azaleaNtpMgmt  3 }

	azaleaNtpSynchronizedTimeUTCString OBJECT-TYPE
		SYNTAX		DisplayString
		MAX-ACCESS	read-only
		STATUS		current
		DESCRIPTION	"Current NTP synchronized network time in UTC string"
		::=  { azaleaNtpMgmt  4 }

