-------------------------------------------------------
-- agentTrapDestTable
-------------------------------------------------------

    agentTrapDestTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF AgentTrapDestEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "A table of the device's trap destination entries."
        ::= { agentTrapMgmtGroup 1 }

    agentTrapDestEntry OBJECT-TYPE
        SYNTAX      AgentTrapDestEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "Device's trap destination entry"
        INDEX       { agentTrapDestIpAddress }
        ::= { agentTrapDestTable 1 }

    AgentTrapDestEntry ::= SEQUENCE {
        agentTrapDestIpAddress                  IpAddress,
        agentTrapDestPort                       INTEGER,
        agentTrapDestTrapCommunity                  DisplayString,
        agentTrapDestTrapVersion                INTEGER,
        agentTrapDestTrapType                   INTEGER
    }

    agentTrapDestIpAddress OBJECT-TYPE
        SYNTAX     IpAddress
        MAX-ACCESS read-only
        STATUS     current
        DESCRIPTION
            "Trap Destination's IP Address"
        ::= { agentTrapDestEntry 1 }
    
    agentTrapDestPort OBJECT-TYPE
        SYNTAX     INTEGER (1..65535)
        MAX-ACCESS read-only
        STATUS     current
        DESCRIPTION
            "Trap Destination's Port"
        ::= { agentTrapDestEntry 2 }
    
    agentTrapDestTrapCommunity OBJECT-TYPE
        SYNTAX     DisplayString
        MAX-ACCESS read-only
        STATUS     current
        DESCRIPTION
            "The trap community used when sending trap to this destination"
        ::= { agentTrapDestEntry 3 }
    
    agentTrapDestTrapVersion OBJECT-TYPE
        SYNTAX     INTEGER {
        	v1(1),
        	v2c(2)
	}
        MAX-ACCESS read-only
        STATUS     current
        DESCRIPTION
            "The trap version used when sending trap to this destination"
        ::= { agentTrapDestEntry 4 }
    
    agentTrapDestTrapType OBJECT-TYPE
        SYNTAX     INTEGER {
        	trap(1),
        	inform(2)
	}
        MAX-ACCESS read-only
        STATUS     current
        DESCRIPTION
            "The trap type used when sending trap to this destination"
        ::= { agentTrapDestEntry 5 }

