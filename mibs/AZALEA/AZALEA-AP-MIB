	azaleaDot11ClientInfoTable	OBJECT-TYPE
		SYNTAX		SEQUENCE  OF  AzaleaDot11ClientInfoEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"This table contains configuration information and 
            statistics of client devices.  Entries on this table are
            created by the device radio driver when clients establish
            association with the device.  Entries are removed
            when clients disassociate with the device."
		::=  { azaleaDot11BssObjects  4 }

	azaleaDot11ClientInfoEntry	OBJECT-TYPE
		SYNTAX		AzaleaDot11ClientInfoEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"Each entry is the device specification of a client
            of this device on the IEEE 802.11 radio interfaces.
            Clients are grouped according to the SSIDs of the
            interfaces they use for associations"
		INDEX		{  ifIndex, azlDot11BssIndex, azlDot11ClientMacAddress }
		::=  { azaleaDot11ClientInfoTable 1 }

	AzaleaDot11ClientInfoEntry  ::=  SEQUENCE {
		azlDot11ClientMacAddress  MacAddress,
		azlDot11ClientAid  Integer32,  
		azlDot11ClientFlags  Integer32,
		azlDot11ClientListenInterval  Integer32,
		azlDot11ClientSessionStart  Integer32,
		azlDot11ClientAssocTime  TimeTicks,
		azlDot11ClientRssi  Integer32,
		azlDot11ClientIpAddress  IpAddress,
		azlDot11ClientRxPackets  Counter32,
		azlDot11ClientTxSuccPackets  Counter32,
		azlDot11ClientRxBytes  Counter32,
		azlDot11ClientTxBytes  Counter32,
		azlDot11ClientTxRateCurrent Gauge32,
		azlDot11ClientTxRateAve  Gauge32,
		azlDot11ClientRxRateAve  Gauge32,
		azlDot11ClientTxRetryPackets Counter32,
		azlDot11ClientRxDroppedPackets Counter32,
		azlDot11ClientTxFailedPackets Counter32,
		azlDot11ClientTxRetryBytes  Counter32,
		azlDot11ClientRxRetryBytes  Counter32,
		azlDot11ClientRxRetryPackets  Counter32,
		azlDot11ClientRxErrorPackets Counter32,
--		azlDot11ClientPowerSaveMode  Integer32,  
		azlDot11ClientAzModel  DisplayString,
