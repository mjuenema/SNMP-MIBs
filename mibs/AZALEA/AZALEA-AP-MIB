		SYNTAX			INTEGER  { allowUnlessExplicitlyDenied ( 1 ) , denyUnlessExplicitlyAllowed ( 2 ) , useRadius ( 3 ) } 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"
			How mac lists are used in authentication:
			allowUnlessExplicitlyDenied(0) 
			   means AP accepts all clients unless their macs are in the
			   deny mac table
			denyUnlessExplicitlyAllowed(1) 
			   means AP denies all clients unless their macs are in the 
			   accept mac table
			useRadius(2) 
			   means AP will query the external RADIUS server for accept/deny
			   if the maclists do not include the client
		   "
		::=  {  azaleaDot11BssEntry  3  }


